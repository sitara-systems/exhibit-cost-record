<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.title }}</title>
<meta name="description" content="{{ page.description|meta_desc }}">
<link rel="canonical" href="{{ site_url }}{{ page.url }}">
{% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="The Exhibit Cost Record">
<meta property="og:title" content="{{ page.title }}">
<meta property="og:description" content="{{ page.description }}">
<meta property="og:url" content="{{ site_url }}{{ page.url }}">
<meta property="og:image" content="https://sitara.systems/assets/images/brand/sitara-mark.png">
<meta name="twitter:card" content="summary">
<link rel="stylesheet" href="/assets/css/site.css">
{% if page.url == "/" %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Dataset","@id":"{{ site_url }}/#dataset","name":"The Exhibit Cost Record","description":"A public-records dataset of {{ stats.total_records }} museum exhibit, interactive, and audiovisual contract costs, assembled from federal contracts, federal and state grants, state procurement portals, UK public tenders, and IRS Form 990 disclosures.","url":"{{ site_url }}/","license":"https://creativecommons.org/licenses/by/4.0/","isAccessibleForFree":true,"creator":{"@type":"Organization","name":"Sitara Systems","url":"https://sitara.systems/"},"publisher":{"@type":"Organization","name":"Sitara Systems","url":"https://sitara.systems/"},"keywords":["museum exhibits","exhibit costs","interactive media","procurement","IRS Form 990","government contracts"],"distribution":[{"@type":"DataDownload","encodingFormat":"text/csv","contentUrl":"{{ site_url }}/assets/data/records.csv"},{"@type":"DataDownload","encodingFormat":"application/json","contentUrl":"{{ site_url }}/assets/data/records.json"},{"@type":"DataDownload","encodingFormat":"application/json","contentUrl":"{{ site_url }}/assets/data/stats.json"}]}
</script>
{% else %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebPage","name":{{ page.title|tojson }},"url":"{{ site_url }}{{ page.url }}","isPartOf":{"@type":"Dataset","@id":"{{ site_url }}/#dataset","name":"The Exhibit Cost Record","url":"{{ site_url }}/"}}
</script>
{% endif %}
{% if not noindex %}
<!-- GA4, added 2026-08-27. Single measurement ID (G-YK22BRNLFM) shared
     across the whole Sitara-family domain (sitara.systems + skies.sitara.systems
     + the folded-in EDI/ECR subdirectories) -- one property, one funnel. -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-YK22BRNLFM"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag("js", new Date());
  gtag("config", "G-YK22BRNLFM");
</script>
{% endif %}
</head>
<body>
<header class="site">
  <div class="wrap">
    <a class="brand" href="/">The Exhibit Cost Record</a>
    <nav class="site">
      <a href="/browse/">Browse</a>
      <a href="/firms/">Firms</a>
      <a href="/findings/">Findings</a>
      <a href="/methodology/">Methodology</a>
      <a href="/benchmarks/">Benchmarks</a>
      <a href="/about/">About</a>
    </nav>
  </div>
</header>
<main class="wrap">
{{ content }}
</main>
<footer class="site">
  <div class="wrap">
    <p>The Exhibit Cost Record is published and maintained by
    <a href="https://sitara.systems">Sitara Systems</a>. Data licensed
    <a href="https://creativecommons.org/licenses/by/4.0/legalcode">CC BY 4.0</a>.
    <a href="/about/">About &amp; rules of the road</a>.</p>
  </div>
</footer>
</body>
</html>
